{
  "name": "renovate-approve-bot-bitbucket-server",
  "description": "A job to approve Pull Requests from Renovate Bot on Bitbucket Server.",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "eslint": "eslint --ext .ts,.js .",
    "eslint-fix": "eslint --ext .ts,.js --fix .",
    "jest": "jest --testPathPattern=tests/",
    "lint": "run-s eslint prettier",
    "lint-fix": "run-s eslint-fix prettier-fix",
    "prettier": "prettier --check \"**/*.{ts,js,json,md,yml}\"",
    "prettier-fix": "prettier --write \"**/*.{ts,js,json,md,yml}\"",
    "start": "node ./dist/index.js",
    "dev": "ts-node ./index.ts",
    "test": "run-s lint jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aidanleuck/renovate-approvebot-bitbucket-server.git"
  },
  "keywords": [
    "automerge",
    "bitbucket-server",
    "bitbucket",
    "bot",
    "renovate"
  ],
  "author": "Aidan Leuck",
  "contributors": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aidanleuck/renovate-approvebot-bitbucket-server/issues"
  },
  "engines": {
    "node": "^18.12.0 || >=20.0.0",
    "npm": "^10.7.0"
  },
  "dependencies": {
    "bunyan": "1.8.15",
    "got": "11.8.6"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.0",
    "@semantic-release/exec": "7.1.0",
    "@types/bunyan": "^1.8.11",
    "@types/got": "^9.6.12",
    "@types/jest": "^30.0.0",
    "@types/nock": "^10.0.3",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "babel-plugin-rewire": "1.2.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-gha": "1.6.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-promise": "7.2.1",
    "jest": "29.7.0",
    "nock": "14.0.10",
    "npm-run-all2": "7.0.2",
    "prettier": "3.6.2",
    "semantic-release": "24.2.7",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "packageManager": "npm@10.9.2"
}
