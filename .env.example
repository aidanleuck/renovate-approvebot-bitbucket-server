# Example environment configuration
# Copy this file to .env and fill in your values

# Required: Bitbucket Server URL
BITBUCKET_SERVER_URL=https://bitbucket.mycompany.com

# Required: Renovate Bot Username
RENOVATE_BOT_USER=renovate-bot

# Authentication (choose one method):

# Option 1: Personal Access Token (recommended)
BITBUCKET_TOKEN=your-personal-access-token

# Option 2: Username/Password
# BITBUCKET_USERNAME=your-bot-username
# BITBUCKET_PASSWORD=your-bot-password

# Optional: Limit to specific project/repository
# BITBUCKET_PROJECT=MYPROJ
# BITBUCKET_REPO=my-repo